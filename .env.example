# Copy this file to .env and adjust values if needed.

# --- MongoDB ---
MONGO_DB=dvf_raw
MONGO_COLLECTION=raw_transactions
MONGO_PORT=27017

# --- Mongo Express (web UI for MongoDB) ---
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me
MONGO_EXPRESS_PORT=8081

# --- PostgreSQL analytical warehouse ---
POSTGRES_DB=dvf_dwh
POSTGRES_USER=dvf_user
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# --- Airflow metadata database (separate from the warehouse) ---
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me

# --- Airflow webserver ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_FIRSTNAME=First Name
AIRFLOW_ADMIN_LASTNAME=Last Name
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_WEBSERVER_PORT=8080
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
AIRFLOW_SECRET_KEY=change-me
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# --- Dashboard ---
DASHBOARD_PORT=8501

# --- DVF data source ---
DVF_BASE_URL=https://files.data.gouv.fr/geo-dvf/latest/csv
DVF_YEARS=2022,2023,2024
DVF_DEPARTMENTS=29,35,44,69,75

# --- ML ---
MODEL_PATH=./models/price_model.joblib

